@page "/db-test"
@using CDC_Diabetes.Data
@using CDC_Diabetes.Models
@using Microsoft.EntityFrameworkCore
@inject HealthcareDbContext DbContext

<PageTitle>Database Connectivity Test</PageTitle>

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white py-3">
            <h3 class="mb-0"><i class="bi bi-database-fill-check"></i> System Health Check</h3>
        </div>
        <div class="card-body text-center p-5">
            @if (_isLoading)
            {
                <div class="spinner-grow text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Querying PostgreSQL Schema...</p>
            }
            else if (_connectionSuccess)
            {
                <div class="alert alert-success border-0 shadow-sm">
                    <h4 class="alert-heading"><i class="bi bi-check-circle-fill"></i> Data Link Established!</h4>
                    <p class="text-dark">The .NET 9 Application is successfully communicating with the CDC Star Schema.</p>
                    <hr />
                    <div class="row">
                        <div class="col-md-6 border-end">
                            <p class="text-muted text-uppercase small fw-bold">Total Fact Records</p>
                            <h2 class="display-5 fw-bold text-primary">@_recordCount.ToString("N0")</h2>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted text-uppercase small fw-bold">Dataset Avg BMI</p>
                            <h2 class="display-5 fw-bold text-success">@_avgBmi.ToString("F1")</h2>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4 text-start">
                    <h5>Connection Details:</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item small"><strong>Schema:</strong> healthcare_analytics</li>
                        <li class="list-group-item small"><strong>Source Table:</strong> fact_diabetes_survey</li>
                        <li class="list-group-item small"><strong>Status:</strong> Integrated with EF Core 9</li>
                    </ul>
                </div>
            }
            else
            {
                <div class="alert alert-danger shadow-sm">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> Connectivity Error</h4>
                    <p class="mb-0">@_errorMessage</p>
                </div>
            }
        </div>
        <div class="card-footer bg-light text-muted small">
            Environment: Development | Provider: Npgsql.EntityFrameworkCore.PostgreSQL
        </div>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _connectionSuccess = false;
    private int _recordCount = 0;
    private decimal _avgBmi = 0;
    private string _errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The Moment of Truth: Can EF Core traverse the Star Schema?
            _recordCount = await DbContext.FactSurveys.CountAsync();
            
            // Calculating Avg BMI across 253,680 records
            var bmiValue = await DbContext.FactSurveys.AverageAsync(f => f.Bmi);
            _avgBmi = (decimal)bmiValue;
            
            _connectionSuccess = true;
        }
        catch (Exception ex)
        {
            // Captures SQL errors (Auth, Missing Table, etc.)
            _errorMessage = ex.InnerException?.Message ?? ex.Message;
            _connectionSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }
}